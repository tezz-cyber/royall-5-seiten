---
---
<section id="kontakt" class="bg-royall-dark text-white py-20">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-2xl md:text-3xl font-bold mb-4">Kontakt</h2>
    <p class="text-gray-300 mb-8">
      Sie haben Fragen oder wünschen ein individuelles Angebot? Wir melden uns zeitnah zurück.
    </p>
    <form class="grid gap-4 text-left max-w-xl mx-auto">
      <input type="text" placeholder="Name" class="rounded-md px-4 py-3 text-royall-dark" />
      <input type="email" placeholder="E-Mail" class="rounded-md px-4 py-3 text-royall-dark" />
      <textarea placeholder="Nachricht" rows="4" class="rounded-md px-4 py-3 text-royall-dark"></textarea>
      <button type="submit" class="bg-royall-gold text-royall-dark font-semibold px-6 py-3 rounded-md hover:opacity-90 transition">
        Nachricht senden
      </button>
    </form>
  </div>
</section>
