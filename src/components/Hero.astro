---

<section class="bg-royall-dark text-white pb-16 md:pb-20">
  <!-- Text-Container: bleibt etwas schmaler für gute Lesbarkeit -->
  <div class="max-w-6xl mx-auto px-4 md:px-6 pt-16 md:pt-24 text-center">
    <h1 class="text-3xl sm:text-4xl md:text-6xl font-bold leading-tight mb-6">
      Royall Service & Security<br class="hidden md:block" /> Dienstleistung GmbH
    </h1>
    <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-10">
      Ihr zuverlässiger Partner für Gebäudereinigung und Trockenbau in Bochum und Umgebung.
    </p>
    <a href="/kontakt" class="inline-block bg-royall-gold text-royall-dark font-semibold px-8 py-3.5 rounded-md hover:opacity-90 transition mb-12">
      Jetzt Kontakt aufnehmen
    </a>
  </div>

  <!-- Bild-Container: breiter als der Text oben (max-w-7xl statt max-w-6xl) -->
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="rounded-xl overflow-hidden shadow-lg">
      <img
        src="/bilder/reini-treppe.jpg"
        alt="Reinigungsteam im Treppenhaus"
        class="w-full h-[320px] sm:h-[420px] md:h-[520px] object-cover object-center"
      />
    </div>
  </div>
</section>