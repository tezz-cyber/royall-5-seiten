---
export interface Props {
  title: string;
  desc?: string;
  href: string;
  img: string;
}
const { title, desc, href, img } = Astro.props;
---

<a
  href={href}
  class="block rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-lg transition group"
>
  <img src={img} alt={title} class="aspect-[4/3] w-full object-cover object-center" />
  <div
    class="bg-royall-dark text-white px-5 py-4 flex items-center justify-between"
  >
    <div>
      <h3 class="font-semibold">{title}</h3>
      {desc && <p class="text-xs text-gray-300 mt-1">{desc}</p>}
    </div>
    <span
      class="text-royall-gold group-hover:translate-x-1 transition-transform"
      >→</span
    >
  </div>
</a>
