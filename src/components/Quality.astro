---
const points = [
  "Regelmäßige Qualitätskontrollen vor Ort",
  "Geschultes und zuverlässiges Fachpersonal",
  "Klare Ansprechpartner & feste Objektbetreuung",
  "Transparente Angebote ohne versteckte Kosten",
];
---

<section id="qualitaet" class="max-w-6xl mx-auto px-6 py-20">
  <h2 class="text-2xl md:text-3xl font-bold mb-10 text-center">Qualität</h2>
  <div class="grid sm:grid-cols-2 gap-6">
    {
      points.map((p) => (
        <div class="flex items-start gap-3 bg-royall-light rounded-lg p-5">
          <span class="text-royall-gold font-bold">✓</span>
          <p class="text-gray-700">{p}</p>
        </div>
      ))
    }
  </div>
</section>
