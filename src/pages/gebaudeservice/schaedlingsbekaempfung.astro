---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServiceDetailLayout from "../../components/ServiceDetailLayout.astro";

const kicker = "Wirksamer Schutz vor Schädlingsbefall";
const title = "Schädlingsbekämpfung";
const intro = [
    "Schädlinge gefährden Hygiene, Bausubstanz und den guten Ruf Ihres Unternehmens. Unsere Schädlingsbekämpfung erkennt Befall frühzeitig und bekämpft ihn fachgerecht, nachhaltig und diskret.",
    "Wir setzen auf zugelassene, umweltschonende Verfahren und beraten Sie zusätzlich zu präventiven Maßnahmen, damit ein erneuter Befall möglichst vermieden wird."
  ];
const features = [
    { title: "Befallserkennung und Analyse", desc: "Fachgerechte Begutachtung zur Bestimmung der Schädlingsart." },
    { title: "Fachgerechte Bekämpfung", desc: "Einsatz zugelassener Mittel und Methoden nach Vorschrift." },
    { title: "Präventionsberatung", desc: "Empfehlungen zur dauerhaften Vermeidung von Befall." },
    { title: "Diskrete Durchführung", desc: "Rücksichtsvolle Umsetzung ohne Betriebsstörung." }
  ];
const badge = undefined;
---
<Layout title="Schädlingsbekämpfung | Royall Service & Security">
  <Header />
  <ServiceDetailLayout kicker={kicker} title={title} intro={intro} features={features} badge={badge} />
  <Footer />
</Layout>
