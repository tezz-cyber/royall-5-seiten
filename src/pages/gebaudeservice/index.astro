---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const items = [
  { title: "Hausmeisterservice", desc: "Technische und organisatorische Betreuung Ihrer Immobilie." },
  { title: "Schädlingsbekämpfung", desc: "Fachgerechte Bekämpfung und Prävention von Schädlingsbefall." },
  { title: "Grünflächenpflege", desc: "Pflege von Rasenflächen, Hecken und Außenanlagen." },
  { title: "Teppichreinigung", desc: "Schonende Tiefenreinigung textiler Bodenbeläge." },
];
---
<Layout title="Gebäudeservice | Royall Service & Security">
  <Header />

  <section class="relative bg-royall-dark text-white">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-16 md:py-20">
      <p class="text-royall-gold font-semibold mb-2">Rundum-Betreuung für Ihre Immobilie</p>
      <h1 class="text-3xl md:text-4xl font-bold mb-6">Gebäudeservice</h1>
      <p class="text-gray-300 max-w-2xl leading-relaxed">
        Eine Immobilie benötigt mehr als nur Reinigung. Mit unserem Gebäudeservice übernehmen wir die technische
        Betreuung, Grünflächenpflege, Schädlingsbekämpfung und Teppichreinigung, damit Sie sich um Ihr
        Kerngeschäft kümmern können, während wir uns um Ihr Objekt kümmern.
      </p>
    </div>
    <div class="h-48 md:h-64 bg-white/5 flex items-center justify-center text-gray-400 text-sm">
      Platzhalter-Bild: Hausmeister bei der Arbeit
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 md:px-6 py-14 md:py-16">
    <p class="text-gray-700 leading-relaxed mb-10">
      Von der regelmäßigen technischen Kontrolle bis zur saisonalen Außenpflege: Wir sind Ihr fester Ansprechpartner
      vor Ort und reagieren schnell und zuverlässig auf Ihre Anliegen.
    </p>

    <h2 class="text-xl md:text-2xl font-bold mb-6">Unsere Leistungen im Gebäudeservice:</h2>
    <div class="grid sm:grid-cols-2 gap-6 mb-10">
      {items.map((i) => (
        <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100">
          <div class="h-36 bg-royall-light flex items-center justify-center text-gray-400 text-sm">
            Platzhalter-Bild: {i.title}
          </div>
          <div class="p-5">
            <h3 class="font-semibold mb-1">{i.title}</h3>
            <p class="text-sm text-gray-600">{i.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <a href="/kontakt" class="inline-block bg-royall-gold text-royall-dark font-semibold px-6 py-3 rounded-md hover:opacity-90 transition">
      Angebot anfordern
    </a>
  </section>

  <Footer />
</Layout>
