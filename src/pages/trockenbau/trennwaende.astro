---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServiceDetailLayout from "../../components/ServiceDetailLayout.astro";

const kicker = "Flexible Raumaufteilung nach Maß";
const title = "Trennwände";
const intro = [
    "Räume verändern sich, Ihre Anforderungen auch. Mit unseren Trockenbau-Trennwänden schaffen wir flexible, nicht tragende Raumlösungen, die sich individuell an Ihre Nutzung anpassen lassen.",
    "Wir realisieren Ständerwände nach aktuellen Normen, auf Wunsch mit integriertem Schall- oder Brandschutz, für Büro-, Gewerbe- und Wohnräume."
  ];
const features = [
    { title: "Ständerwände nach DIN 18183", desc: "Fachgerechte Ausführung in Metallständerbauweise." },
    { title: "Schallschutz-Optionen", desc: "Reduzierte Geräuschübertragung zwischen Räumen." },
    { title: "Brandschutzausführungen", desc: "Wände mit erhöhter Feuerwiderstandsklasse auf Anfrage." },
    { title: "Individuelle Raumplanung", desc: "Beratung zur optimalen Aufteilung Ihrer Fläche." }
  ];
const badge = "Neu für Royall";
---
<Layout title="Trennwände | Royall Service & Security">
  <Header />
  <ServiceDetailLayout kicker={kicker} title={title} intro={intro} features={features} badge={badge} />
  <Footer />
</Layout>
