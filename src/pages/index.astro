---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Footer from "../components/Footer.astro";

const categories = [
  { title: "Gebäudereinigung", desc: "Unterhalts-, Glas-, Grund- & Bauendreinigung.", href: "/gebaudereinigung" },
  { title: "Gebäudeservice", desc: "Hausmeister, Schädlinge, Grünflächen, Teppiche.", href: "/gebaudeservice" },
];
---
<Layout title="Royall Service & Security Dienstleistung GmbH">
  <Header />
  <Hero />
  <section class="max-w-4xl mx-auto px-4 md:px-6 py-16">
    <h2 class="text-2xl md:text-3xl font-bold mb-8 text-center">Unsere Leistungsbereiche</h2>
    <div class="grid sm:grid-cols-2 gap-6">
      {categories.map((s) => <ServiceCard {...s} />)}
    </div>
  </section>
  <Footer />
</Layout>
