---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Unternehmen | Royall Service & Security">
  <Header />
  <section class="max-w-4xl mx-auto px-4 md:px-6 py-16 md:py-20">
    <h1 class="text-3xl font-bold mb-6">Über uns</h1>
    <div
      class="h-56 md:h-72 bg-royall-light rounded-xl flex items-center justify-center text-gray-400 text-sm mb-8"
    >
      Platzhalter-Bild: Team / Unternehmen
    </div>
    <p class="text-gray-700 leading-relaxed mb-4">
      Die Royall Service & Security Dienstleistung GmbH mit Sitz in Bochum steht
      für Zuverlässigkeit, Qualität und persönlichen Service.
    </p>
    <p class="text-gray-700 leading-relaxed">
      Wir betreuen Wohn- und Gewerbeimmobilien im gesamten Ruhrgebiet und bieten
      unseren Kunden ein breites Leistungsspektrum aus einer Hand.
    </p>
  </section>
  <Footer />
</Layout>
